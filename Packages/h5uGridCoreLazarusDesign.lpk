<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="h5uGridCoreLazarusDesign"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../Source/Common;../Source/Design"/>
        <UnitOutputDirectory Value="../_dcu/$(TargetOS)_$(TargetCPU)_Lazarus"/>
      </SearchPaths>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="../Source/Design/h5u.Grid.Design.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="h5u.Grid.Design"/>
      </Item>
      <Item>
        <Filename Value="../Source/Common/h5u.Grid.SampleData.pas"/>
        <UnitName Value="h5u.Grid.SampleData"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="h5uGridCoreLazarus"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
