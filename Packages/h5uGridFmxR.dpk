package h5uGridFmxR;

{$DESCRIPTION 'h5u Grid FMX runtime'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  fmx,
  h5uGridCoreR;

contains
  Fmx.h5u.Grid.Styles in '..\Source\FMX\Fmx.h5u.Grid.Styles.pas',
  Fmx.h5u.Grid.Editors in '..\Source\FMX\Fmx.h5u.Grid.Editors.pas',
  Fmx.h5u.Grid in '..\Source\FMX\Fmx.h5u.Grid.pas';

end.
